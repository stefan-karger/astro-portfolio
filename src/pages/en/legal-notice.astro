---
import BaseLayout from "@/layouts/base-layout.astro"
import LegalArticle from "@/components/legal-article.astro"
import PostalAddress from "@/components/postal-address.astro"
import { siteConfig } from "@/data/site"
import { getTranslations } from "@/i18n/translations"
---

<BaseLayout
  title={`${siteConfig.name.brand} - Legal Notice`}
  description={getTranslations("en").legal.metaDescription}
  noindex
>
  <LegalArticle>
    <h1>Legal Notice</h1>

    <h2>Information pursuant to § 5 DDG</h2>
    <p>
      <PostalAddress />
    </p>

    <h2>Contact</h2>
    <p>
      Email:{" "}
      <a
        class="site-link text-muted [font-family:inherit] hover:text-ink"
        href={`mailto:${siteConfig.contact.email}`}
      >
        {siteConfig.contact.email}
      </a>
      <br />
      Phone:{" "}
      <a
        class="site-link text-muted [font-family:inherit] hover:text-ink"
        href={`tel:${siteConfig.contact.phone.replaceAll(" ", "")}`}
      >
        {siteConfig.contact.phone}
      </a>
    </p>
  </LegalArticle>
</BaseLayout>
