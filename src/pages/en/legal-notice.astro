---
import BaseLayout from "@/layouts/base-layout.astro"
import LegalArticle from "@/components/legal-article.astro"
import PostalAddress from "@/components/postal-address.astro"
import { siteConfig } from "@/lib/config"
---

<BaseLayout title={`${siteConfig.name.public} - Legal notice`}>
  <LegalArticle>
    <h1>Legal notice</h1>

    <h2>Information pursuant to § 5 DDG</h2>
    <p>
      <PostalAddress />
    </p>

    <h2>Contact</h2>
    <p>
      Email:{" "}
      <a
        class="site-link font-normal text-muted hover:text-ink"
        href={`mailto:${siteConfig.contact.email}`}
      >
        {siteConfig.contact.email}
      </a>
      <br />
      Phone:{" "}
      <a
        class="site-link font-normal text-muted hover:text-ink"
        href={`tel:${siteConfig.contact.phone.replaceAll(" ", "")}`}
      >
        {siteConfig.contact.phone}
      </a>
    </p>
  </LegalArticle>
</BaseLayout>
