---
import BaseLayout from "@/layouts/base-layout.astro"
import PortfolioGallery from "@/components/portfolio/portfolio-gallery.astro"
import { getTranslations } from "@/i18n/translations"
import { siteConfig } from "@/lib/config"

const { portfolio } = getTranslations("en")
---

<BaseLayout
  title={`${portfolio.title} | ${siteConfig.name.public}`}
  description={portfolio.metaDescription}
  mainClass="w-full flex-1"
>
  <PortfolioGallery />
</BaseLayout>
