---
import BaseLayout from "@/layouts/base-layout.astro"
import LegalArticle from "@/components/legal-article.astro"
import PostalAddress from "@/components/postal-address.astro"
import { siteConfig } from "@/lib/config"
import { getTranslations } from "@/i18n/translations"
---

<BaseLayout
  title={`${siteConfig.name.public} - Impressum`}
  description={getTranslations("de").legal.metaDescription}
  noindex
>
  <LegalArticle>
    <h1>Impressum</h1>

    <h2>Angaben gemäß § 5 DDG</h2>
    <p>
      <PostalAddress />
    </p>

    <h2>Kontakt</h2>
    <p>
      E-Mail:{" "}
      <a class="text-link" href={`mailto:${siteConfig.contact.email}`}>
        {siteConfig.contact.email}
      </a>
      <br />
      Telefon:{" "}
      <a class="text-link" href={`tel:${siteConfig.contact.phone.replaceAll(" ", "")}`}>
        {siteConfig.contact.phone}
      </a>
    </p>
  </LegalArticle>
</BaseLayout>
