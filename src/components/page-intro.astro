---
interface Props {
  id: string
  title: string
  description?: string
}

const { id, title, description } = Astro.props
---

<div class="mx-auto mb-[clamp(2.5rem,5vw,4rem)] w-[calc(100%-2rem)] max-w-6xl">
  <h1
    id={id}
    class="m-0 font-mono text-[clamp(2.5rem,4.5vw,4rem)] leading-[1.1] font-bold tracking-[-0.045em]"
  >
    {title}
  </h1>
  {description && <p class="mt-4 max-w-160 text-lg text-muted">{description}</p>}
</div>
