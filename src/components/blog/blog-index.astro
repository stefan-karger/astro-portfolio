---
import PageIntro from "@/components/page-intro.astro"
import { resolveLocale } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import { formatPostDate, getPosts, postUrl } from "@/lib/blog"

const locale = resolveLocale(Astro.currentLocale)
const t = getTranslations(locale)
const posts = await getPosts()
---

<section class="pt-[clamp(2.5rem,7vw,7rem)] pb-16 sm:pb-24" aria-labelledby="blog-title">
  <PageIntro id="blog-title" title="Blog" description={t.blog.description} />
  <div class="mx-auto w-[calc(100%-2rem)] max-w-6xl">
    {posts.length === 0 ? (
      <p class="text-muted">{t.blog.empty}</p>
    ) : (
      <ul class="divide-y divide-rule border-y border-rule">
        {posts.map((post) => (
          <li class="py-8 sm:py-10">
            <article class="grid gap-4 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-8">
              <div class="flex flex-wrap items-center gap-3 text-sm text-muted sm:flex-col sm:items-start">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatPostDate(locale, post.data.pubDate)}
                </time>
                <span class="inline-flex items-center rounded-full border border-rule px-2.5 py-0.5 text-xs">
                  {t.blog.language[post.data.language]}
                </span>
                {post.data.draft && <span class="text-xs">{t.blog.draft}</span>}
                {post.data.series && (
                  <span class="text-xs">
                    {t.blog.part} {post.data.series.part}
                  </span>
                )}
              </div>
              <div class="min-w-0">
                <h2
                  class="text-2xl leading-snug font-semibold tracking-tight wrap-break-word sm:text-3xl"
                  lang={post.data.language}
                >
                  <a class="text-link" href={postUrl(locale, post.id)}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-3 max-w-[70ch] text-muted" lang={post.data.language}>
                  {post.data.description}
                </p>
                {post.data.tags.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2" aria-label={t.blog.tags}>
                    {post.data.tags.map((tag) => (
                      <li
                        class="rounded-full bg-ink/5 px-2.5 py-0.5 text-xs text-muted"
                        lang={post.data.language}
                      >
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
