---
import type { CollectionEntry } from "astro:content"

import type { Locale } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import { postUrl } from "@/lib/blog"

interface Props {
  post: CollectionEntry<"blog">
  posts: CollectionEntry<"blog">[]
  locale: Locale
}

const { post, posts, locale } = Astro.props
const t = getTranslations(locale)
const series = post.data.series
---

{series && posts.length > 0 && (
  <nav class="post-series mt-8 max-w-[75ch]" aria-label={t.blog.series}>
    <h2 class="text-sm font-semibold text-muted">{t.blog.series}</h2>
    <ol class="series-list mt-2 text-sm">
      {posts.map((entry) => (
        <li class="series-item" data-series-part={entry.data.series!.part}>
          <a
            class="series-link text-link inline-block min-h-11 py-2.5 text-muted no-underline hover:bg-transparent hover:text-ink hover:underline focus-visible:text-ink aria-[current]:font-bold aria-[current]:text-ink"
            href={postUrl(locale, entry.id)}
            aria-current={entry.id === post.id ? "page" : undefined}
          >
            {`${t.blog.part} ${entry.data.series!.part}: `}
            <span lang={entry.data.language}>
              {entry.data.title.replace(`${series.name}: `, "")}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .series-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-left: 0.25rem;
    border-left: 1px solid var(--color-rule);
  }

  .series-link {
    /* One inline text flow keeps the hover underline continuous between words. */
    text-decoration-skip-ink: none;
  }

  .series-item {
    position: relative;
    padding-left: 1.25rem;
  }

  .series-item::before {
    content: "";
    position: absolute;
    top: 1.125rem;
    left: -0.25rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border: 1px solid var(--color-muted);
    border-radius: 50%;
    background: var(--color-paper);
  }

  .series-item:has([aria-current])::before {
    border-color: var(--color-ink);
    background: var(--color-ink);
  }
</style>
