---
import type { CollectionEntry } from "astro:content"

import type { Locale } from "@/i18n/locales"
import { getTranslations } from "@/i18n/translations"
import { routeUrl } from "@/i18n/url"
import { formatPostDate } from "@/lib/blog"
import { siteConfig } from "@/data/site"

interface Props {
  post: CollectionEntry<"blog">
  locale: Locale
}

const { post, locale } = Astro.props
const t = getTranslations(locale)
const date = post.data.updatedDate ?? post.data.pubDate
---

<header class="post-header max-w-[75ch]">
  <a
    class="site-link inline-flex min-h-11 items-center text-sm text-muted"
    href={routeUrl(locale, "blog")}
  >
    {t.blog.back}
  </a>
  <div class="mt-6">
    {post.data.draft && <p class="mt-3 text-sm text-muted">{t.blog.draft}</p>}
    <h1
      id="post-title"
      class="mt-5 font-mono text-[1.75rem] leading-[1.15] font-bold tracking-[-0.035em] wrap-break-word sm:text-page-title"
      lang={post.data.language}
    >
      {post.data.title}
    </h1>
    <p class="post-description mt-5 text-lg text-muted" lang={post.data.language}>
      {post.data.description}
    </p>
    <p id="post-author" class="mt-5 text-sm text-muted">
      {t.blog.author}{" "}
      <a
        class="site-link underline-offset-4 [font-family:inherit]"
        href={routeUrl(locale, "home")}
        rel="author"
      >
        {siteConfig.name.full}
      </a>
    </p>
    <div class="post-dates mt-1.5 text-sm text-muted">
      <span id={post.data.updatedDate ? "post-updated" : undefined}>
        {post.data.updatedDate ? t.blog.updated : t.blog.published}
        {": "}
        <time datetime={date.toISOString()}>{formatPostDate(locale, date)}</time>
      </span>
    </div>
    {post.data.tags.length > 0 && (
      <ul class="post-tags mt-5 flex flex-wrap gap-2" aria-label={t.blog.tags}>
        {post.data.tags.map((tag) => (
          <li
            class="rounded-full bg-ink/5 px-2.5 py-0.5 text-xs text-muted"
            lang={post.data.language}
          >
            {tag}
          </li>
        ))}
      </ul>
    )}
  </div>
</header>
