---
import type { Locale } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getTranslations(locale)
---

<div
  id="code-controls"
  lang={locale}
  data-locale={locale}
  data-copy={t.blog.copy}
  data-copied={t.blog.copied}
  data-error={t.blog.copyError}
>
  <span id="code-copy-label" class="sr-only">
    {t.blog.copy}
  </span>
  <span id="code-type-info-label" class="sr-only">
    {t.blog.typeInfo}
  </span>
  <p id="code-copy-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  const controls = document.querySelector<HTMLElement>("#code-controls")
  const status = document.querySelector<HTMLElement>("#code-copy-status")
  const timers = new WeakMap<HTMLButtonElement, number>()
  const copying = new WeakSet<HTMLButtonElement>()

  if (controls && status && navigator.clipboard?.writeText) {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((button) => {
      button.hidden = false
      button.lang = controls.dataset.locale ?? ""
      button.title = controls.dataset.copy ?? ""
    })

    document.addEventListener("click", async (event) => {
      if (!(event.target instanceof Element)) return
      const button = event.target.closest<HTMLButtonElement>("[data-copy-code]")
      if (
        !button ||
        button.disabled ||
        copying.has(button) ||
        button.dataset.copyCode === undefined
      )
        return

      window.clearTimeout(timers.get(button))
      copying.add(button)
      button.setAttribute("aria-busy", "true")
      status.textContent = ""
      let message: string
      try {
        await navigator.clipboard.writeText(button.dataset.copyCode)
        button.dataset.state = "copied"
        message = controls.dataset.copied ?? ""
      } catch {
        button.dataset.state = "error"
        message = controls.dataset.error ?? ""
      } finally {
        copying.delete(button)
        button.removeAttribute("aria-busy")
      }
      button.title = message
      status.textContent = message
      timers.set(
        button,
        window.setTimeout(() => {
          button.dataset.state = "idle"
          button.title = controls.dataset.copy ?? ""
        }, 2_000)
      )
    })
  }

  if ("showPopover" in HTMLElement.prototype) {
    let active: HTMLElement | undefined
    let activeTrigger: HTMLButtonElement | undefined
    let closeTimer: number | undefined

    function position(popup: HTMLElement, trigger: HTMLElement) {
      const rect = trigger.getBoundingClientRect()
      const gap = 8
      popup.style.transform = "none"
      const maxLeft = Math.max(gap, window.innerWidth - popup.offsetWidth - gap)
      const top =
        rect.bottom + gap + popup.offsetHeight <= window.innerHeight - gap
          ? rect.bottom + gap
          : Math.max(gap, rect.top - popup.offsetHeight - gap)
      popup.style.left = `${Math.min(Math.max(gap, rect.left), maxLeft)}px`
      popup.style.top = `${Math.min(top, Math.max(gap, window.innerHeight - popup.offsetHeight - gap))}px`
    }

    function open(trigger: HTMLButtonElement) {
      window.clearTimeout(closeTimer)
      const popup = document.getElementById(trigger.dataset.twoslashTrigger ?? "")
      if (!popup) return
      if (active && active !== popup) active.hidePopover()
      if (!popup.matches(":popover-open")) popup.showPopover()
      active = popup
      activeTrigger = trigger
      position(popup, trigger)
    }

    function close() {
      window.clearTimeout(closeTimer)
      if (active?.matches(":popover-open")) active.hidePopover()
      active = undefined
      activeTrigger = undefined
    }

    document.querySelectorAll<HTMLButtonElement>("[data-twoslash-trigger]").forEach((trigger) => {
      const popup = document.getElementById(trigger.dataset.twoslashTrigger ?? "")
      if (!popup) return
      trigger.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") open(trigger)
      })
      trigger.addEventListener("focus", () => open(trigger))
      trigger.addEventListener("click", (event) => {
        event.preventDefault()
        open(trigger)
      })
      const scheduleClose = () => {
        closeTimer = window.setTimeout(() => {
          if (document.activeElement !== trigger && !popup.matches(":hover")) close()
        }, 150)
      }
      trigger.addEventListener("pointerleave", scheduleClose)
      trigger.addEventListener("blur", scheduleClose)
      popup.addEventListener("pointerenter", () => window.clearTimeout(closeTimer))
      popup.addEventListener("pointerleave", scheduleClose)
      popup.addEventListener("toggle", () => {
        if (popup.matches(":popover-open")) position(popup, trigger)
        else if (active === popup) {
          active = undefined
          activeTrigger = undefined
        }
      })
    })
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close()
    })
    document.addEventListener(
      "scroll",
      (event) => {
        if (event.target instanceof Node && active?.contains(event.target)) return
        close()
      },
      { capture: true, passive: true }
    )
    window.addEventListener("resize", () => {
      if (active && activeTrigger) position(active, activeTrigger)
    })
  }
</script>
