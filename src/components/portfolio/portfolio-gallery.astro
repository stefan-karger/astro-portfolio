---
import type { ImageMetadata } from "astro"

import { resolveLocale } from "@/i18n/locales"
import { getTranslations } from "@/i18n/translations"
import PageIntro from "@/components/page-intro.astro"
import PortfolioImage from "./portfolio-image.astro"

const locale = resolveLocale(Astro.currentLocale)
const { portfolio } = getTranslations(locale)

const files = Object.keys(import.meta.glob("/src/assets/portfolio/*"))
const modules = import.meta.glob<ImageMetadata>(
  "/src/assets/portfolio/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}",
  { eager: true, import: "default" }
)
const prefixes = new Set<string>()

for (const path of files) {
  const filename = path.split("/").pop()!
  if (!modules[path]) throw new Error(`Unsupported portfolio source: ${filename}`)
  if (!/^\d+-[a-z0-9]+(?:[-_][a-z0-9]+)*\.(?:jpe?g|png|webp)$/i.test(filename)) {
    throw new Error(`Portfolio filenames must use NNN-descriptive-name.ext: ${filename}`)
  }
  const prefix = String(Number(filename.split("-")[0]))
  if (prefixes.has(prefix)) console.warn(`Duplicate portfolio order prefix: ${filename}`)
  prefixes.add(prefix)
}

const images = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b, "en", { numeric: true }))
  .map(([path, image]) => {
    const key = path
      .split("/")
      .pop()!
      .replace(/^\d+-/, "")
      .replace(/\.[^.]+$/, "")
      .toLowerCase()
    if (!Object.hasOwn(portfolio.imageAlts, key)) {
      throw new Error(`Missing ${locale} portfolio image translation: ${key}`)
    }
    return { path, image, alt: portfolio.imageAlts[key as keyof typeof portfolio.imageAlts] }
  })
---

<section class="pt-[clamp(2.5rem,7vw,7rem)] pb-16 sm:pb-24" aria-labelledby="portfolio-title">
  <PageIntro id="portfolio-title" title={portfolio.title} description={portfolio.intro} />

  <script is:inline>
    document.documentElement.dataset.portfolioJs = ""
  </script>
  <div class="mx-auto w-full max-w-[105rem] px-4 sm:px-6 lg:px-8">
    <div
      class="group/portfolio columns-(--portfolio-columns) gap-(--portfolio-gap) [--portfolio-columns:1] [--portfolio-gap:12px] sm:[--portfolio-columns:2] lg:[--portfolio-columns:3] 2xl:[--portfolio-columns:4] [html[data-portfolio-js]_&]:grid [html[data-portfolio-js]_&]:grid-cols-[repeat(var(--portfolio-columns),minmax(0,1fr))] [html[data-portfolio-js]_&]:items-start [html[data-portfolio-js]_&[data-enhanced]]:relative [html[data-portfolio-js]_&[data-enhanced]]:block [html[data-portfolio-js]_&[data-enhanced]]:columns-auto"
      data-portfolio-gallery
      data-dialog-label={portfolio.lightbox.label}
      data-carousel-description={portfolio.lightbox.carousel}
      data-slide-description={portfolio.lightbox.slide}
      data-close-title={portfolio.lightbox.close}
      data-zoom-in-title={portfolio.lightbox.zoomIn}
      data-zoom-out-title={portfolio.lightbox.zoomOut}
      data-previous-title={portfolio.lightbox.previous}
      data-next-title={portfolio.lightbox.next}
      data-error-message={portfolio.lightbox.error}
    >
      {images.map(({ path, image, alt }, index) => (
        <PortfolioImage sourcePath={path} image={image} alt={alt} index={index} />
      ))}
    </div>
  </div>
</section>

<script>
  import "./gallery"
</script>

<style>
  /* PhotoSwipe creates these elements after the lightbox opens. */
  :global(.portfolio-lightbox) {
    --pswp-bg: #151513;
    --pswp-icon-color: #fcfcfb;
    font-family: var(--font-mono);
  }

  :global(.portfolio-lightbox .pswp__button:focus-visible) {
    outline: 2px solid #fcfcfb;
    outline-offset: -6px;
  }
</style>
