---
import type { Locale } from "@/i18n/locales"
import { getTranslations } from "@/i18n/translations"
import { routeUrl } from "@/i18n/url"
import { siteConfig } from "@/data/site"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
const year = new Date().getFullYear()
const currentPath = Astro.url.pathname.replace(/\/+$/, "")
const legalLinks = [
  { label: t.nav.legal, href: routeUrl(locale, "legal") },
  { label: t.nav.privacy, href: routeUrl(locale, "privacy") }
]
---

<footer class="@container/footer border-t border-rule bg-paper text-ink">
  <div class="mx-auto grid w-full max-w-7xl grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-6 px-4 py-8 @min-[50rem]/footer:grid-cols-[minmax(0,0.8fr)_minmax(0,1.7fr)] @min-[50rem]/footer:grid-rows-[1fr_auto] @min-[50rem]/footer:gap-x-[clamp(3rem,8vw,8rem)] @min-[50rem]/footer:gap-y-10 @min-[50rem]/footer:py-[clamp(3rem,7vw,6rem)] sm:px-6 lg:px-8">
    <div class="@container col-span-2 row-start-1 min-w-0 @min-[50rem]/footer:col-span-1 @min-[50rem]/footer:col-start-2 @min-[50rem]/footer:row-span-2">
      <div class="grid grid-cols-2 gap-x-4 gap-y-6 @min-[38rem]:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)_minmax(0,0.7fr)] @min-[50rem]/footer:gap-x-8 @min-[50rem]/footer:gap-y-10">
        <div class="col-span-2 min-w-0 @min-[38rem]:col-span-1">
          <h2 class="m-0 mb-3 font-mono text-lg font-bold wrap-anywhere @min-[50rem]/footer:mb-5 @min-[50rem]/footer:text-xl">
            {t.footer.contact}
          </h2>
          <ul class="m-0 list-none p-0">
            <li>
              <a
                class="site-link inline-flex min-h-11 max-w-full items-center text-muted wrap-anywhere hover:text-ink"
                href={`mailto:${siteConfig.contact.email}`}
              >
                {siteConfig.contact.email}
              </a>
            </li>
            <li>
              <a
                class="site-link inline-flex min-h-11 max-w-full items-center text-muted wrap-anywhere hover:text-ink"
                href={`tel:${siteConfig.contact.phone.replaceAll(" ", "")}`}
              >
                {siteConfig.contact.phone}
              </a>
            </li>
          </ul>
        </div>
        <nav class="min-w-0" aria-label={t.nav.socialLinksLabel}>
          <h2 class="m-0 mb-3 font-mono text-lg font-bold wrap-anywhere @min-[50rem]/footer:mb-5 @min-[50rem]/footer:text-xl">
            {t.footer.elsewhere}
          </h2>
          <ul class="m-0 list-none p-0">
            {siteConfig.socialLinks.map((social) => (
              <li>
                <a
                  class="site-link inline-flex min-h-11 max-w-full items-center text-muted wrap-anywhere hover:text-ink"
                  href={social.href}
                  target="_blank"
                  rel="me noopener noreferrer"
                >
                  {social.label}
                  <span class="sr-only"> ({t.links.opensInNewTab})</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="min-w-0" aria-label={t.nav.legalLabel}>
          <h2 class="m-0 mb-3 font-mono text-lg font-bold wrap-anywhere @min-[50rem]/footer:mb-5 @min-[50rem]/footer:text-xl">
            {t.nav.legalLabel}
          </h2>
          <ul class="m-0 list-none p-0">
            {legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={currentPath === link.href.replace(/\/+$/, "") ? "page" : undefined}
                  class="site-link inline-flex min-h-11 max-w-full items-center text-muted wrap-anywhere hover:text-ink aria-[current=page]:font-bold aria-[current=page]:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
    <span
      aria-hidden="true"
      class="col-start-1 row-start-2 self-center font-mono text-[2rem] leading-[0.8] font-bold tracking-[-0.09em] @min-[50rem]/footer:row-start-1 @min-[50rem]/footer:self-start @min-[50rem]/footer:text-[clamp(5rem,12vw,11rem)]"
    >
      SK.
    </span>
    <p class="col-start-2 row-start-2 m-0 min-w-0 self-center text-right text-sm text-muted @min-[50rem]/footer:col-start-1 @min-[50rem]/footer:self-end @min-[50rem]/footer:text-left">
      © {year} {siteConfig.name.brand}
    </p>
  </div>
</footer>
