---
import { defaultLocale, locales } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import { siteConfig } from "@/lib/config"

interface Props {
  class?: string
}

const { class: className } = Astro.props
const locale = locales.find((item) => item === Astro.currentLocale) ?? defaultLocale
const t = getTranslations(locale)
---

<a
  href={`mailto:${siteConfig.contact.email}`}
  class:list={[
    "inline-flex min-h-11 w-max max-w-full items-center justify-center rounded-none bg-ink px-4 py-2.5 font-mono text-base leading-[1.3] font-semibold text-paper text-center no-underline hover:bg-ink-hover hover:text-paper hover:no-underline",
    className
  ]}
>
  {t.contact.emailAction}
</a>
