---
import type { Locale } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import { routeUrl } from "@/i18n/url"
import { siteConfig } from "@/lib/config"
import LanguageSwitch from "./language-switch.astro"

interface Props {
  locale: Locale
  isErrorPage?: boolean
}

const { locale, isErrorPage = false } = Astro.props
const t = getTranslations(locale)
const navRoutes = ["home", "portfolio", "blog"] as const

function normalizePath(path: string) {
  return path.replace(/\/+$/, "") || "/"
}

const navItems = navRoutes.map((route) => {
  const href = routeUrl(locale, route)
  const path = normalizePath(Astro.url.pathname)
  const isCurrent = path === normalizePath(href)

  return {
    href,
    label: t.nav[route],
    current: isCurrent
      ? ("page" as const)
      : route === "blog" && path.startsWith(`${normalizePath(href)}/`)
        ? ("location" as const)
        : undefined
  }
})
---

<header class="sticky top-0 z-40 bg-paper">
  <div class="mx-auto grid min-h-header w-full max-w-7xl grid-cols-[1fr_auto] items-center gap-x-4 px-4 sm:grid-cols-[1fr_auto_1fr] sm:gap-x-8 sm:px-6 lg:px-8">
    <a
      href={routeUrl(locale, "home")}
      class="site-link -ml-2 hidden min-h-11 min-w-11 items-center justify-center justify-self-start p-2 text-xl leading-none font-bold tracking-[-0.04em] sm:inline-flex"
      aria-label={`SK, ${siteConfig.name.public}, ${t.nav.homeLinkLabel}`}
    >
      SK.
    </a>

    <button
      type="button"
      popovertarget="mobile-nav"
      aria-label={t.nav.menu}
      class="menu-trigger -ml-2 min-h-11 min-w-11 items-center justify-self-start p-2 hover:text-ink-hover"
    >
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>

    <nav aria-label={t.nav.primaryLabel} class="hidden justify-self-center sm:block">
      <ul class="flex list-none items-center gap-4 sm:gap-6 lg:gap-8">
        {navItems.map(({ href, label, current }) => (
          <li>
            <a
              href={href}
              class="site-link inline-flex min-h-11 items-center py-2 text-muted underline-offset-[0.45em] hover:text-ink aria-[current]:font-bold aria-[current]:text-ink"
              aria-current={current}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {!isErrorPage && <LanguageSwitch />}

    <nav
      id="mobile-nav"
      popover="auto"
      aria-label={t.nav.primaryLabel}
      class="mobile-nav col-span-2 sm:hidden"
    >
      <a
        href={routeUrl(locale, "home")}
        class="site-link -ml-2 mb-6 inline-flex min-h-11 min-w-11 items-center p-2 text-xl leading-none font-bold tracking-[-0.04em]"
        aria-label={`SK, ${siteConfig.name.public}, ${t.nav.homeLinkLabel}`}
      >
        SK.
      </a>
      <ul class="flex list-none flex-col gap-3">
        {navItems.map(({ href, label, current }) => (
          <li>
            <a
              href={href}
              class="site-link flex min-h-11 items-center py-2 text-2xl text-muted hover:text-ink aria-[current]:font-bold aria-[current]:text-ink"
              aria-current={current}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .menu-trigger {
    display: none;
  }

  .menu-icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition:
      top 100ms,
      transform 100ms;
  }

  .menu-icon span:first-child {
    top: 0.25rem;
  }

  .menu-icon span:last-child {
    top: 0.625rem;
  }

  header:has(#mobile-nav:popover-open) .menu-icon span:first-child {
    top: 0.4rem;
    transform: rotate(-45deg);
  }

  header:has(#mobile-nav:popover-open) .menu-icon span:last-child {
    top: 0.4rem;
    transform: rotate(45deg);
  }

  @supports selector(:popover-open) {
    @media (width < 40rem) {
      :global(html) {
        scrollbar-gutter: stable;
      }

      .menu-trigger {
        display: inline-flex;
      }

      .mobile-nav {
        position: fixed;
        inset: var(--spacing-header) 0 0;
        width: auto;
        height: auto;
        margin: 0;
        border: 0;
        padding: 1.5rem 1rem;
        overflow-y: auto;
        overscroll-behavior: contain;
        background: var(--color-paper);
        color: var(--color-ink);
      }

      :global(html:has(#mobile-nav:popover-open)) {
        overflow: hidden;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-icon span {
      transition: none;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLElement>("#mobile-nav")
  const trigger = document.querySelector<HTMLButtonElement>("[popovertarget='mobile-nav']")

  if (menu && trigger && "hidePopover" in menu) {
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a[href]")) {
        menu.hidePopover()
      }
    })

    document.addEventListener("focusin", (event) => {
      if (
        menu.matches(":popover-open") &&
        event.target instanceof Node &&
        !menu.contains(event.target) &&
        !trigger.contains(event.target)
      ) {
        menu.hidePopover()
      }
    })

    window.matchMedia("(min-width: 40rem)").addEventListener("change", (event) => {
      if (event.matches && menu.matches(":popover-open")) {
        menu.hidePopover()
      }
    })
  }
</script>
