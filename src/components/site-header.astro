---
import type { Locale } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import { routeUrl } from "@/i18n/url"
import { siteConfig } from "@/lib/config"
import LanguageSwitch from "./language-switch.astro"

interface Props {
  locale: Locale
  isErrorPage?: boolean
}

const { locale, isErrorPage = false } = Astro.props
const t = getTranslations(locale)
const navRoutes = ["home", "portfolio", "blog"] as const

function normalizePath(path: string) {
  return path.replace(/\/+$/, "") || "/"
}

const currentPath = normalizePath(Astro.url.pathname)
const navItems = navRoutes.map((route) => {
  const href = routeUrl(locale, route)
  const targetPath = normalizePath(href)
  let current: "page" | "location" | undefined

  if (currentPath === targetPath) {
    current = "page"
  } else if (route === "blog" && currentPath.startsWith(`${targetPath}/`)) {
    current = "location"
  }

  return {
    href,
    label: t.nav[route],
    current
  }
})
---

<header class="group/header sticky top-0 z-40 bg-paper">
  <div class="mx-auto grid min-h-header w-full max-w-7xl grid-cols-[1fr_auto] items-center gap-x-4 px-4 sm:grid-cols-[1fr_auto_1fr] sm:gap-x-8 sm:px-6 lg:px-8">
    <a
      href={routeUrl(locale, "home")}
      class="site-link -ml-2 hidden min-h-11 min-w-11 items-center justify-center justify-self-start p-2 text-xl leading-none font-bold tracking-[-0.04em] sm:inline-flex"
      aria-label={`SK, ${siteConfig.name.public}, ${t.nav.homeLinkLabel}`}
    >
      SK.
    </a>

    <button
      type="button"
      popovertarget="mobile-nav"
      aria-label={t.nav.menu}
      class="-ml-2 hidden min-h-11 min-w-11 items-center justify-self-start p-2 hover:text-ink-hover supports-[selector(:popover-open)]:max-sm:inline-flex"
    >
      <span class="relative size-4 shrink-0" aria-hidden="true">
        <span class="absolute top-1 left-0 h-0.5 w-full bg-current transition-[top,rotate] duration-100 ease-[ease] group-has-[#mobile-nav:popover-open]/header:top-[0.4rem] group-has-[#mobile-nav:popover-open]/header:-rotate-45 motion-reduce:transition-none"></span>
        <span class="absolute top-2.5 left-0 h-0.5 w-full bg-current transition-[top,rotate] duration-100 ease-[ease] group-has-[#mobile-nav:popover-open]/header:top-[0.4rem] group-has-[#mobile-nav:popover-open]/header:rotate-45 motion-reduce:transition-none"></span>
      </span>
    </button>

    <nav aria-label={t.nav.primaryLabel} class="hidden justify-self-center sm:block">
      <ul class="flex list-none items-center gap-4 sm:gap-6 lg:gap-8">
        {navItems.map(({ href, label, current }) => (
          <li>
            <a
              href={href}
              class="site-link inline-flex min-h-11 items-center py-2 text-muted underline-offset-[0.45em] hover:text-ink aria-[current]:font-bold aria-[current]:text-ink"
              aria-current={current}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {!isErrorPage && <LanguageSwitch {locale} />}

    <nav
      id="mobile-nav"
      popover="auto"
      aria-label={t.nav.primaryLabel}
      class="col-span-2 sm:hidden supports-[selector(:popover-open)]:max-sm:fixed supports-[selector(:popover-open)]:max-sm:inset-x-0 supports-[selector(:popover-open)]:max-sm:top-header supports-[selector(:popover-open)]:max-sm:bottom-0 supports-[selector(:popover-open)]:max-sm:m-0 supports-[selector(:popover-open)]:max-sm:h-auto supports-[selector(:popover-open)]:max-sm:w-auto supports-[selector(:popover-open)]:max-sm:overflow-y-auto supports-[selector(:popover-open)]:max-sm:overscroll-contain supports-[selector(:popover-open)]:max-sm:border-0 supports-[selector(:popover-open)]:max-sm:bg-paper supports-[selector(:popover-open)]:max-sm:px-4 supports-[selector(:popover-open)]:max-sm:py-6 supports-[selector(:popover-open)]:max-sm:text-ink"
    >
      <a
        href={routeUrl(locale, "home")}
        class="site-link -ml-2 mb-6 inline-flex min-h-11 min-w-11 items-center p-2 text-xl leading-none font-bold tracking-[-0.04em]"
        aria-label={`SK, ${siteConfig.name.public}, ${t.nav.homeLinkLabel}`}
      >
        SK.
      </a>
      <ul class="flex list-none flex-col gap-3">
        {navItems.map(({ href, label, current }) => (
          <li>
            <a
              href={href}
              class="site-link flex min-h-11 items-center py-2 text-2xl text-muted hover:text-ink aria-[current]:font-bold aria-[current]:text-ink"
              aria-current={current}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>("#mobile-nav")
  const trigger = document.querySelector<HTMLButtonElement>("[popovertarget='mobile-nav']")

  if (menu && trigger && "hidePopover" in menu) {
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a[href]")) {
        menu.hidePopover()
      }
    })

    document.addEventListener("focusin", (event) => {
      if (
        menu.matches(":popover-open") &&
        event.target instanceof Node &&
        !menu.contains(event.target) &&
        !trigger.contains(event.target)
      ) {
        menu.hidePopover()
      }
    })

    window.matchMedia("(min-width: 40rem)").addEventListener("change", (event) => {
      if (event.matches && menu.matches(":popover-open")) {
        menu.hidePopover()
      }
    })
  }
</script>
