---
import { Picture } from "astro:assets"

import portrait from "@/assets/hero.jpg"
import { defaultLocale, locales } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import { siteConfig } from "@/lib/config"
import EmailButton from "@/components/email-button.astro"

const locale = locales.find((item) => item === Astro.currentLocale) ?? defaultLocale
const t = getTranslations(locale)
---

<section
  class="min-h-[calc(100svh-5rem)] px-[clamp(1rem,4vw,4rem)] pt-[clamp(5rem,11vw,10rem)] pb-[clamp(7rem,10vw,9rem)] max-[45rem]:min-h-[auto] max-[45rem]:pt-10 max-[45rem]:pb-16"
  aria-labelledby="home-hero-title"
>
  <div class="mx-auto grid w-full max-w-5xl grid-cols-[minmax(15rem,21rem)_minmax(22rem,1fr)] items-center gap-[clamp(3rem,8vw,7.5rem)] max-[45rem]:grid-cols-1 max-[45rem]:gap-6">
    <figure class="m-0 max-[45rem]:w-[min(55vw,13rem)]">
      <Picture
        src={portrait}
        alt={t.home.hero.imageAlt(siteConfig.name.public)}
        formats={["avif", "webp"]}
        fallbackFormat="jpeg"
        widths={[240, 320, 420, 640, 840]}
        sizes="(max-width: 719px) min(55vw, 13rem), (max-width: 52rem) calc(100vw - 29rem), 21rem"
        width={840}
        height={1050}
        quality="high"
        priority
        class="block w-full [filter:grayscale(0.12)_brightness(1.08)_contrast(0.96)_saturate(0.92)]"
      />
    </figure>

    <div>
      <h1
        id="home-hero-title"
        class="m-0 max-w-[12ch] font-mono text-display leading-[1.08] font-bold tracking-[-0.02em]"
      >
        {t.home.hero.greeting}
      </h1>
      <p class="mt-[1.8rem] max-w-[40rem] text-lg leading-[1.6] text-muted max-[45rem]:mt-6">
        {t.home.hero.intro}
      </p>
      <p class="mt-4 max-w-[40rem] text-lg leading-[1.6] text-muted">{t.home.hero.photography}</p>
      <EmailButton class="mt-6" />
    </div>
  </div>
</section>
