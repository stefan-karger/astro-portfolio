---
import { Picture } from "astro:assets"

import portrait from "@/assets/hero.jpg"
import { resolveLocale } from "@/i18n/locales"
import { getTranslations } from "@/i18n/translations"
import { siteConfig } from "@/data/site"
import EmailButton from "@/components/email-button.astro"

const locale = resolveLocale(Astro.currentLocale)
const t = getTranslations(locale)
---

<section
  class="@container px-[clamp(1rem,4vw,4rem)] pt-[clamp(2.5rem,7vw,7rem)] pb-[clamp(4rem,8vw,8rem)] lg:pb-[clamp(6rem,10vw,10rem)]"
  aria-labelledby="home-hero-title"
>
  <div class="mx-auto grid w-full max-w-5xl grid-cols-1 items-center gap-6 @min-[45rem]:grid-cols-[minmax(0,21rem)_minmax(0,1fr)] @min-[45rem]:gap-[clamp(3rem,8vw,7.5rem)]">
    <figure class="m-0 w-[min(55vw,11.25rem)] @min-[45rem]:w-full">
      <Picture
        src={portrait}
        alt={t.home.hero.imageAlt(siteConfig.name.brand)}
        formats={["avif", "webp"]}
        fallbackFormat="jpeg"
        widths={[240, 320, 420, 640, 840]}
        sizes="(width < 49rem) min(55vw, 11.25rem), 21rem"
        width={840}
        height={1050}
        quality="high"
        priority
        class="block w-full filter-[grayscale(0.12)_brightness(1.08)_contrast(0.96)_saturate(0.92)]"
      />
    </figure>

    <div class="min-w-0">
      <h1
        id="home-hero-title"
        class="m-0 max-w-[12ch] font-mono text-display leading-[1.08] font-bold tracking-[-0.02em]"
      >
        {t.home.hero.greeting}
      </h1>
      <p class="mt-6 max-w-160 text-lg leading-[1.6] text-muted @min-[45rem]:mt-[1.8rem]">
        {t.home.hero.intro}
      </p>
      <p class="mt-4 max-w-160 text-lg leading-[1.6] text-muted">{t.home.hero.photography}</p>
      <EmailButton {locale} class="mt-6" />
    </div>
  </div>
</section>
