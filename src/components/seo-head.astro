---
import portrait from "@/assets/hero.jpg"
import { defaultLocale, locales, type Locale } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import { routeUrl, switchLocale } from "@/i18n/url"
import { siteConfig } from "@/lib/config"

interface Props {
  title: string
  description: string
  locale: Locale
  canonicalPath?: string
  noindex?: boolean
  article?: {
    language: Locale
    publishedTime: string
  }
  isErrorPage?: boolean
}

const {
  title: inputTitle,
  description: inputDescription,
  locale,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  article,
  isErrorPage = false
} = Astro.props
const title = inputTitle?.trim()
const description = inputDescription?.trim()

if (!title || !description) {
  throw new Error(`Missing SEO title or description for ${Astro.url.pathname}`)
}
if (!Astro.site) {
  throw new Error("Missing `site` in astro.config.mjs")
}

const canonical = new URL(canonicalPath, Astro.site)
if (canonical.origin !== Astro.site.origin) {
  throw new Error(`Canonical must use the site origin for ${Astro.url.pathname}`)
}
canonical.search = ""
canonical.hash = ""

const alternates = locales.map((target) => ({
  locale: target,
  href: new URL(switchLocale(Astro.url.pathname, locale, target), Astro.site).href
}))
const xDefault = new URL(switchLocale(Astro.url.pathname, locale, defaultLocale), Astro.site).href
const metadataLocale = article?.language ?? locale
const ogLocales = { de: "de_DE", en: "en_US" }
const image = new URL(siteConfig.socialImage.path, Astro.site).href
const imageAlt = getTranslations(metadataLocale).seo.imageAlt
const isHome =
  Astro.url.pathname.replace(/\/+$/, "") === routeUrl(locale, "home").replace(/\/+$/, "")
const personId = new URL("/#person", Astro.site).href
const websiteId = new URL("/#website", Astro.site).href
const profileData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: new URL("/", Astro.site).href,
      name: siteConfig.name.public,
      inLanguage: locales,
      publisher: { "@id": personId }
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonical.href}#profile`,
      url: canonical.href,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { "@id": websiteId },
      mainEntity: { "@id": personId }
    },
    {
      "@type": "Person",
      "@id": personId,
      name: siteConfig.name.legal,
      alternateName: siteConfig.name.public,
      url: new URL("/", Astro.site).href,
      image: new URL(portrait.src, Astro.site).href,
      sameAs: siteConfig.socialLinks.map(({ href }) => href)
    }
  ]
}
---

<title>{title}</title>
<meta name="description" content={description} />
{(isErrorPage || noindex) && (
  <meta name="robots" content={isErrorPage ? "noindex" : "noindex, follow"} />
)}

{!isErrorPage && (
  <>
    <link rel="canonical" href={canonical.href} />
    {alternates.map(({ locale, href }) => (
      <link rel="alternate" hreflang={locale} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={siteConfig.name.public} />
    <meta property="og:locale" content={ogLocales[metadataLocale]} />
    {!article &&
      locales
        .filter((target) => target !== locale)
        .map((target) => <meta property="og:locale:alternate" content={ogLocales[target]} />)}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content={siteConfig.socialImage.type} />
    <meta property="og:image:width" content={String(siteConfig.socialImage.width)} />
    <meta property="og:image:height" content={String(siteConfig.socialImage.height)} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {isHome && !noindex && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(profileData).replace(/</g, "\\u003c")}
      ></script>
    )}
  </>
)}
