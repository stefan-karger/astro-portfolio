---
import { resolveLocale } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"

const prototypes = [{ id: 0 }, { id: 1 }, { id: 2 }, { id: 3 }] as const

const locale = resolveLocale(Astro.currentLocale)
const t = getTranslations(locale)
---

<script is:inline>
  ;(() => {
    const supported = new Set(["0", "1", "2", "3"])
    const requested = new URLSearchParams(window.location.search).get("prototype")

    document.documentElement.dataset.prototype = supported.has(requested ?? "") ? requested : "0"
  })()
</script>

<nav
  class="fixed right-[max(1rem,env(safe-area-inset-right))] bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 flex items-center gap-[0.7rem] border border-[#c9c9c9] bg-white/94 pt-[0.4rem] pr-[0.45rem] pb-[0.4rem] pl-3 font-mono text-[0.68rem] text-[#171717] shadow-[0_0.5rem_2rem_rgba(0,0,0,0.14)] backdrop-blur-md max-[40rem]:bottom-[max(4.5rem,env(safe-area-inset-bottom))] max-[27rem]:pl-[0.45rem]"
  aria-label={t.prototype.navigationLabel}
>
  <span class="text-[#676767] max-[27rem]:sr-only">{t.prototype.label}</span>
  <ol class="m-0 flex list-none gap-[0.2rem] p-0">
    {prototypes.map((prototype) => (
      <li>
        <a
          href={`?prototype=${prototype.id}`}
          data-prototype-link={prototype.id}
          class="grid size-[1.8rem] place-items-center text-[#171717] no-underline hover:bg-[#eeeeee] aria-[current=page]:bg-[#171717] aria-[current=page]:text-white aria-[current=page]:hover:bg-[#171717]"
          aria-label={`${t.prototype.itemLabel} ${prototype.id}`}
          title={`${t.prototype.label} ${prototype.id}`}
        >
          {prototype.id}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script is:inline>
  ;(() => {
    const current = document.documentElement.dataset.prototype ?? "0"

    document.querySelectorAll("[data-prototype-link]").forEach((link) => {
      if (link.getAttribute("data-prototype-link") === current) {
        link.setAttribute("aria-current", "page")
      }
    })
  })()
</script>
