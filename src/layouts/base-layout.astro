---
import "@fontsource-variable/jetbrains-mono/wght.css"
import "@fontsource-variable/ibm-plex-sans/wght.css"
import "@/styles/global.css"

import { defaultLocale, resolveLocale, type Locale } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import SeoHead from "@/components/seo-head.astro"

interface Props {
  title: string
  description: string
  mainClass?: string
  canonicalPath?: string
  noindex?: boolean
  article?: {
    language: Locale
    publishedTime: string
    modifiedTime?: string
  }
  isErrorPage?: boolean
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  article,
  isErrorPage = false,
  mainClass = "mx-auto w-full max-w-7xl flex-1 px-4 sm:px-6 lg:px-8"
} = Astro.props

const locale = isErrorPage ? defaultLocale : resolveLocale(Astro.currentLocale)
const t = getTranslations(locale)
---

<!doctype html>
<html
  lang={locale}
  class="scroll-pt-[calc(var(--spacing-header)+1rem)] supports-[selector(:popover-open)]:max-sm:scrollbar-gutter-stable supports-[selector(:popover-open)]:max-sm:has-[#mobile-nav:popover-open]:overflow-hidden"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <SeoHead {title} {description} {locale} {canonicalPath} {noindex} {article} {isErrorPage} />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col bg-paper font-sans leading-relaxed text-ink">
    <a
      class="site-link fixed top-3 left-4 z-50 -translate-y-24 bg-ink px-3 py-2 text-paper focus:translate-y-0"
      href="#main-content"
    >
      {t.nav.skipLink}
    </a>
    <SiteHeader {locale} {isErrorPage} />
    <main id="main-content" class={mainClass} tabindex="-1">
      <slot />
    </main>
    <SiteFooter {locale} />
  </body>
</html>
