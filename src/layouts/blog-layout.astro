---
import { render, type CollectionEntry } from "astro:content"

import BaseLayout from "@/layouts/base-layout.astro"
import CodeBlockControls from "@/components/blog/code-block-controls.astro"
import { defaultLocale, locales } from "@/i18n/types"
import { getTranslations } from "@/i18n/translations"
import { routeUrl } from "@/i18n/url"
import { formatPostDate, getPosts, postUrl } from "@/lib/blog"
import { siteConfig } from "@/lib/config"

interface Props {
  post: CollectionEntry<"blog">
}
const { post } = Astro.props
if (typeof post.rendered?.html !== "string") {
  throw new Error(
    `Markdown rendering failed for blog post "${post.id}". Check the content rendering errors above.`
  )
}
const { Content, headings } = await render(post)
const locale = locales.find((item) => item === Astro.currentLocale) ?? defaultLocale
const t = getTranslations(locale)
const posts = await getPosts()
const index = posts.findIndex((entry) => entry.id === post.id)
const previous = posts[index + 1]
const next = index > 0 ? posts[index - 1] : undefined
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
---

<BaseLayout
  title={`${post.data.title} - ${siteConfig.name.public}`}
  description={post.data.description}
  canonicalPath={postUrl(post.data.language, post.id)}
  article={{ language: post.data.language, publishedTime: post.data.pubDate.toISOString() }}
>
  <article
    class="mx-auto min-w-0 max-w-6xl pt-10 pb-16 sm:pt-16 sm:pb-24"
    aria-labelledby="post-title"
  >
    <header class="max-w-[75ch]">
      <a
        class="site-link inline-flex min-h-11 items-center text-sm text-muted"
        href={routeUrl(locale, "blog")}
      >
        {t.blog.back}
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-muted">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatPostDate(locale, post.data.pubDate)}
        </time>
        <span class="rounded-full border border-rule px-2.5 py-0.5 text-xs">
          {t.blog.language[post.data.language]}
        </span>
        {post.data.draft && <span>{t.blog.draft}</span>}
      </div>
      <h1
        id="post-title"
        class="mt-4 font-mono text-page-title leading-[1.15] font-bold tracking-[-0.035em] wrap-break-word"
        lang={post.data.language}
      >
        {post.data.title}
      </h1>
      <p class="mt-5 text-lg text-muted" lang={post.data.language}>
        {post.data.description}
      </p>
      {post.data.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" aria-label={t.blog.tags}>
          {post.data.tags.map((tag) => (
            <li
              class="rounded-full bg-ink/5 px-2.5 py-0.5 text-xs text-muted"
              lang={post.data.language}
            >
              {tag}
            </li>
          ))}
        </ul>
      )}
    </header>
    <CodeBlockControls locale={locale} />
    <div class="mt-12 grid min-w-0 gap-10 xl:grid-cols-[minmax(0,1fr)_14rem] xl:gap-14">
      {contents.length > 0 && (
        <aside class="min-w-0 xl:col-start-2 xl:row-start-1">
          <nav
            id="blog-contents"
            class="xl:sticky xl:top-[calc(var(--spacing-header)+2rem)] xl:max-h-[calc(100dvh-var(--spacing-header)-4rem)] xl:overflow-y-auto"
            aria-label={t.blog.contents}
          >
            <p class="mb-3 text-sm font-bold text-muted">{t.blog.contents}</p>
            <ul class="space-y-2 text-sm leading-snug text-muted" lang={post.data.language}>
              {contents.map((heading) => (
                <li class:list={[heading.depth === 3 && "pl-3"]}>
                  <a
                    class="inline-block py-1 no-underline underline-offset-[0.45em] hover:text-ink hover:underline aria-[current]:text-ink"
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
      <div
        class="blog-content min-w-0 max-w-[85ch] xl:col-start-1 xl:row-start-1 xl:max-w-none"
        lang={post.data.language}
      >
        <Content />
      </div>
    </div>
    <nav
      class="mt-14 max-w-[85ch] border-t border-rule pt-6 xl:max-w-[calc(100%-17.5rem)]"
      aria-label={t.blog.navigation}
    >
      <a
        class="site-link inline-flex min-h-11 items-center text-sm"
        href={routeUrl(locale, "blog")}
      >
        {t.blog.back}
      </a>
      {(previous || next) && (
        <div class="mt-5 grid gap-6 sm:grid-cols-2">
          {[
            { post: previous, label: t.blog.previous },
            { post: next, label: t.blog.next }
          ].map(
            ({ post: entry, label }) =>
              entry && (
                <a class="text-link block py-2" href={postUrl(locale, entry.id)}>
                  <span class="block text-xs text-muted">{label}</span>
                  <span class="mt-1 block font-semibold" lang={entry.data.language}>
                    {entry.data.title}
                  </span>
                </a>
              )
          )}
        </div>
      )}
    </nav>
  </article>
</BaseLayout>

<script>
  const contents = document.querySelector<HTMLElement>("#blog-contents")
  const links = contents?.querySelectorAll<HTMLAnchorElement>("a[href^='#']") ?? []
  const sections = Array.from(links).flatMap((link) => {
    const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
    return heading ? [{ link, heading }] : []
  })

  if (contents && sections.length > 0) {
    let active: HTMLAnchorElement | undefined
    let frame: number | undefined

    const update = () => {
      frame = undefined
      // Match the heading position after following a native anchor link.
      const offset =
        parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) +
        parseFloat(getComputedStyle(sections[0].heading).scrollMarginTop)
      let current = sections[0]

      for (const section of sections) {
        if (section.heading.getBoundingClientRect().top > offset + 1) break
        current = section
      }

      if (active === current.link) return
      active?.removeAttribute("aria-current")
      current.link.setAttribute("aria-current", "location")
      active = current.link
      if (current === sections[0]) contents.scrollTop = 0

      const bounds = contents.getBoundingClientRect()
      const linkBounds = active.getBoundingClientRect()
      if (linkBounds.top < bounds.top) {
        contents.scrollTop += linkBounds.top - bounds.top
      } else if (linkBounds.bottom > bounds.bottom) {
        contents.scrollTop += linkBounds.bottom - bounds.bottom
      }
    }

    function scheduleUpdate() {
      if (frame === undefined) frame = window.requestAnimationFrame(update)
    }

    window.addEventListener("scroll", scheduleUpdate, { passive: true })
    window.addEventListener("resize", scheduleUpdate)
    window.addEventListener("pageshow", scheduleUpdate)
    update()
  }
</script>
